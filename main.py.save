#!/usr/bin/env python3
"""GitHub Release Watcher — macOS menu bar release notifications."""

import json
import os
import re
import subprocess
import threading
import urllib.error
import urllib.parse
import urllib.request
import webbrowser
from datetime import datetime
from pathlib import Path

import rumps

APP_NAME = "GitHub Release Watcher"
CHECK_INTERVAL_SECONDS = 60 * 60
API_VERSION = "2022-11-28"
APP_DIR = Path.home() / "Library" / "Application Support" / APP_NAME
STATE_FILE = APP_DIR / "state.json"
REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")


def empty_state():
    return {"repositories": {}, "last_check": None}


def load_state():
    APP_DIR.mkdir(parents=True, exist_ok=True)
    try:
        data = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        if not isinstance(data, dict) or not isinstance(data.get("repositories"), dict):
            raise ValueError("Unexpected state file format")
        data.setdefault("last_check", None)
        return data
    except FileNotFoundError:
        return empty_state()
    except (json.JSONDecodeError, ValueError):
        rumps.notification(APP_NAME, "Settings reset", "The saved settings file was invalid; a fresh one will be created.")
        return empty_state()


def save_state(state):
    APP_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2, ensure_ascii=False), encoding="utf-8")
    tmp.replace(STATE_FILE)


def normalize_repo(raw):
    value = raw.strip()
    if not value:
        raise ValueError("Enter a GitHub repository URL or owner/repo.")
    if value.startswith(("https://", "http://")):
        parsed = urllib.parse.urlparse(value)
        if parsed.netloc.lower() not in ("github.com", "www.github.com"):
            raise ValueError("Please enter a URL from github.com.")
        parts = [p for p in parsed.path.strip("/").split("/") if p]
        if len(parts) < 2:
            raise ValueError("The URL must look like https://github.com/owner/repo.")
        value = "/".join(parts[:2])
    value = value.removesuffix(".git").strip("/")
    if not REPO_RE.fullmatch(value) or "." in value.split("/")[0] and value.split("/")[0] in (".", ".."):
        raise ValueError("Repository must look like owner/repo.")
    return value


def fetch_releases(repo):
    url = f"https://api.github.com/repos/{repo}/releases?per_page=100"
    request = urllib.request.Request(url, headers={
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": API_VERSION,
        "User-Agent": "GitHub-Release-Watcher-macOS",
    })
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            payload = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        if exc.code == 404:
            raise RuntimeError("Repository not found, or it has no accessible releases (HTTP 404).") from exc
        if exc.code == 403:
            raise RuntimeError("GitHub API rate limit reached. Try again later.") from exc
        raise RuntimeError(f"GitHub returned HTTP {exc.code}.") from exc
    except urllib.error.URLError as exc:
        raise RuntimeError(f"Network error: {exc.reason}") from exc
    if not isinstance(payload, list):
        raise RuntimeError("GitHub returned an unexpected response.")
    # Draft releases are normally hidden from public unauthenticated requests; ignore them regardless.
    return [r for r in payload if isinstance(r, dict) and not r.get("draft", False) and r.get("id") is not None]


class ReleaseWatcher(rumps.App):
    def __init__(self):
        super().__init__("GH", title="GH", quit_button=None)
        self.state = load_state()
        self._busy = False
        self._lock = threading.Lock()
        self._refresh_menu()
        self.timer = rumps.Timer(self._timer_check, CHECK_INTERVAL_SECONDS)
        self.timer.start()
        # First launch creates a baseline; it does not notify for old releases.
        if not self.state["repositories"]:
            self.menu.add(rumps.MenuItem("Add your first repository…", callback=self._add_repo))
        else:
            threading.Thread(target=self._check_all, kwargs={"initial": not bool(self.state.get("last_check"))}, daemon=True).start()

    def _refresh_menu(self):
        self.menu.clear()
        self.menu.add(rumps.MenuItem("Check now", callback=self._check_now))
        self.menu.add(rumps.MenuItem("Add repository…", callback=self._add_repo))
        repos = self.state.get("repositories", {})
        if repos:
            self.menu.add(rumps.separator)
            for repo in sorted(repos):
                item = rumps.MenuItem(repo)
                item.add(rumps.MenuItem("Open GitHub repository", callback=lambda _, r=repo: webbrowser.open(f"https://github.com/{r}")))
                item.add(rumps.MenuItem("Open latest tracked release", callback=lambda _, r=repo: self._open_release(r)))
                item.add(rumps.MenuItem("Remove repository…", callback=lambda _, r=repo: self._remove_repo(r)))
                self.menu.add(item)
        self.menu.add(rumps.separator)
        last = self.state.get("last_check")
        label = f"Last check: {last}" if last else "Last check: not yet checked"
        self.menu.add(rumps.MenuItem(label, callback=None))
        self.menu.add(rumps.MenuItem("Quit", callback=self._quit))

    def _quit(self, _):
        rumps.quit_application()

    def _open_release(self, repo):
        entry = self.state["repositories"].get(repo, {})
        url = entry.get("latest_url") or f"https://github.com/{repo}/releases"
        webbrowser.open(url)

    def _add_repo(self, _):
        window = rumps.Window(
            message="Paste a GitHub repository URL or type owner/repo.\nExample: https://github.com/owner/project",
            title="Add GitHub repository", default_text="", ok="Add", cancel="Cancel", dimensions=(420, 24)
        )
        response = window.run()
        if not response.clicked:
            return
        try:
            repo = normalize_repo(response.text)
        except ValueError as exc:
            rumps.alert("Invalid repository", str(exc))
            return
        if repo in self.state["repositories"]:
            rumps.alert("Already tracking", f"{repo} is already in your list.")
/Users/AKYL             return
        try:
            releases = fetch_releases(repo)
        except RuntimeError as exc:
            rumps.alert("Couldn't add repository", str(exc))
            return
        latest = releases[0] if releases else None
        self.state["repositories"][repo] = {
            "seen_ids": [r["id"] for r in releases],
            "latest_url": latest.get("html_url") if latest else f"https://github.com/{repo}/releases",
            "latest_tag": latest.get("tag_name") if latest else None,
            "initialized": True,
        }
        save_state(self.state)
        self._refresh_menu()
        if latest:
            rumps.notification(APP_NAME, f"Now tracking {repo}", f"Current release: {latest.get('name') or latest.get('tag_name', 'Unknown')}. New releases will trigger notifications.")
        else:
            rumps.notification(APP_NAME, f"Now tracking {repo}", "No published releases found yet. I'll keep checking hourly.")

    def _remove_repo(self, repo):
        answer = rumps.alert("Remove repository?", f"Stop tracking {repo}?", ok="Remove", cancel="Keep")
        if answer != 1:
            return
        self.state["repositories"].pop(repo, None)
        save_state(self.state)
        self._refresh_menu()
        rumps.notification(APP_NAME, "Repository removed", repo)

    def _check_now(self, _):
        threading.Thread(target=self._check_all, daemon=True).start()
        rumps.notification(APP_NAME, "Check started", "Checking tracked GitHub repositories…")

    def _timer_check(self, _):
        threading.Thread(target=self._check_all, daemon=True).start()

    def _check_all(self, initial=False):
        with self._lock:
            if self._busy:
                return
            self._busy = True
        try:
            any_error = False
            changed = False
            for repo in list(self.state.get("repositories", {})):
                try:
                    releases = fetch_releases(repo)
                    entry = self.state["repositories"].setdefault(repo, {})
                    ids_now = [r["id"] for r in releases]
                    seen = set(entry.get("seen_ids", []))
                    if not entry.get("initialized", False):
                        entry["seen_ids"] = ids_now
                        entry["initialized"] = True
                    else:
                        new_releases = [r for r in releases if r["id"] not in seen]
                        # List newest-first; send one notification per newly discovered release.
                        for release in reversed(new_releases):
                            tag = release.get("tag_name") or "New release"
                            title = release.get("name") or tag
                            kind = "Pre-release / beta" if release.get("prerelease") else "New release"
                            rumps.notification(f"{repo} — {kind}", title, tag, sound=True)
                            # Keep the release URL available in the menu.
                            entry["latest_url"] = release.get("html_url") or f"https://github.com/{repo}/releases"
                            entry["latest_tag"] = tag
                        entry["seen_ids"] = list(dict.fromkeys(ids_now + entry.get("seen_ids", [])))[:500]
                    if releases:
                        entry["latest_url"] = releases[0].get("html_url") or f"https://github.com/{repo}/releases"
                        entry["latest_tag"] = releases[0].get("tag_name")
                    changed = True
                except RuntimeError as exc:
                    any_error = True
                    print(f"[{APP_NAME}] {repo}: {exc}")
            self.state["last_check"] = datetime.now().astimezone().strftime("%Y-%m-%d %H:%M:%S %Z")
            save_state(self.state)
            self._refresh_menu()
            if any_error:
                rumps.notification(APP_NAME, "Some checks failed", "Open the app's menu and choose Check now to retry. Details are in the app's terminal/log output.")
            elif changed:
                print(f"[{APP_NAME}] Check completed at {self.state['last_check']}")
        finally:
            with self._lock:
                self._busy = False


if __name__ == "__main__":
    ReleaseWatcher().run()
